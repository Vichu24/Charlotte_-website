{
  "name": "charlotte-driving-academy-automation",
  "version": "1.0.0",
  "description": "Playwright + JavaScript automation framework for Charlotte Driving Academy (charlottestaging.newagesmb.com)",
  "main": "index.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression --project=chromium --workers=1",
    "test:unit": "node --test unit/projectLogger.test.js",
    "test:sheet": "playwright test --grep @sheet",
    "test:e2e": "playwright test tests/e2e",
    "test:funnel": "playwright test tests/regression/packageListing.spec.js tests/regression/upcomingClasses.spec.js tests/regression/contract.spec.js tests/regression/studentInformation.spec.js tests/regression/payment.spec.js tests/e2e/paymentSuccess.spec.js",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:staging": "cross-env ENV=staging playwright test",
    "test:prod": "cross-env ENV=production playwright test",
    "test:parallel": "playwright test --workers=4",
    "report": "playwright show-report reports/html-report",
    "codegen": "playwright codegen https://charlottestaging.newagesmb.com",
    "install:browsers": "playwright install --with-deps",
    "lint": "eslint config fixtures pages tests unit utils global-setup.js playwright.config.js --ext .js",
    "lint:fix": "eslint config fixtures pages tests unit utils global-setup.js playwright.config.js --ext .js --fix",
    "format": "prettier --write \"**/*.js\"",
    "trace:show": "playwright show-trace"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "allure-playwright": "^2.15.1",
    "cross-env": "^7.0.3",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
