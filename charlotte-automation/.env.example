# Copy this file to .env and fill in real values. .env is gitignored.

# Which environment config/environments.js should resolve ("staging" | "production")
ENV=staging

# Base URLs
STAGING_BASE_URL=https://charlottestaging.newagesmb.com
PRODUCTION_BASE_URL=https://charlottedrivingacademy.com

# Test run behaviour
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
RETRIES=1
WORKERS=4
IGNORE_HTTPS_ERRORS=false
RUN_PAYMENT_SUCCESS_E2E=false

# Contact form test inputs (kept out of source control on purpose)
TEST_USER_FIRST_NAME=QA
TEST_USER_LAST_NAME=Automation
TEST_USER_EMAIL=qa.automation@example.com
TEST_USER_PHONE=7045551234

# Reporting
ALLURE_RESULTS_DIR=reports/allure-results
